{
  "name": "web-app",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:optimized": "node scripts/buildWithOptimizations.js",
    "build:analyze": "ANALYZE=true vite build && node scripts/analyzeBundleSize.js",
    "audit:weight": "node scripts/auditPageWeight.js",
    "audit:page": "node scripts/auditPerPageWeight.js",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "optimize:images": "node scripts/generateResponsiveImages.js",
    "optimize:new-images": "node scripts/optimizeImages.js",
    "optimize:assets": "node scripts/optimizeAssets.js",
    "generate:manifest": "node scripts/generateImageManifest.js",
    "test:compression": "node scripts/testCompression.js",
    "mobile:analyze": "node scripts/optimizeMobilePerformance.js",
    "mobile:test": "node scripts/testMobilePerformance.js",
    "lhci:collect": "lhci collect",
    "lhci:assert": "lhci assert",
    "lhci:upload": "lhci upload",
    "lhci:desktop": "lhci autorun --config=lighthouserc.js",
    "lhci:mobile": "lhci autorun --config=lighthouserc.mobile.js",
    "lhci:slow3g": "lhci autorun --config=lighthouserc.slow3g.js",
    "lhci:full": "npm run build && npm run lhci:desktop && npm run lhci:mobile",
    "lhci:test-setup": "node scripts/testLighthouseCISetup.js",
    "test:slow-network": "node scripts/testSlowNetworkPerformance.js",
    "validate:performance": "node scripts/finalPerformanceValidation.js",
    "validate:quick": "node scripts/quickPerformanceCheck.js",
    "validate:reviews": "node scripts/validate-review-schema.mjs",
    "validate:faqs": "node scripts/validate-faq-schema.mjs",
    "validate:location-seo": "node scripts/validate-location-seo.mjs",
    "fix:location-keywords": "node scripts/fix-location-keywords.mjs",
    "enhance:location-schema": "node scripts/enhance-location-schema.mjs",
    "add:faq-schema-locations": "node scripts/add-faq-schema-locations.mjs",
    "add:geo-coordinates": "node scripts/add-geo-coordinates.mjs",
    "add:address-field": "node scripts/add-address-field.mjs",
    "validate:all": "node scripts/final-validation-check.mjs"
  },
  "dependencies": {
    "@emailjs/browser": "^4.3.3",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-avatar": "^1.0.3",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.5",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@tailwindcss/typography": "^0.5.16",
    "axios": "^1.13.2",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^10.18.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.292.0",
    "markdown-it": "^14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet": "^6.1.0",
    "react-helmet-async": "^2.0.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.16.0",
    "react-share": "^5.2.2",
    "remark-gfm": "^4.0.1",
    "remark-slug": "^7.0.1",
    "remark-toc": "^9.0.0",
    "tailwind-merge": "^1.14.0",
    "tailwindcss-animate": "^1.0.7",
    "vite-plugin-markdown": "^2.2.0",
    "vite-plugin-sitemap": "^0.8.2",
    "web-vitals": "^5.1.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@babel/generator": "^7.27.0",
    "@babel/parser": "^7.27.0",
    "@babel/traverse": "^7.27.0",
    "@babel/types": "^7.27.0",
    "@lhci/cli": "^0.15.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.8.3",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.0.3",
    "@vitest/ui": "^4.0.14",
    "autoprefixer": "^10.4.16",
    "critters": "^0.0.23",
    "eslint": "^8.57.1",
    "eslint-config-react-app": "^7.0.1",
    "fast-check": "^4.3.0",
    "jsdom": "^27.2.0",
    "postcss": "^8.4.31",
    "rollup-plugin-visualizer": "^6.0.5",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.3.3",
    "terser": "^5.39.0",
    "vite": "^7.2.4",
    "vitest": "^4.0.14"
  }
}
